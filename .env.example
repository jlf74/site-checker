# Скопируйте в .env.local и заполните

# Ключ Claude API (console.anthropic.com). Без ключа приложение работает в демо-режиме.
ANTHROPIC_API_KEY=

# Модель для проверок (по умолчанию claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Секрет для подписи cookie и токенов лимитов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Без него ключ случайный, и лимиты сбрасываются при каждом перезапуске.
CHECKUP_SECRET=

# 1 = показать ссылку «режим разработчика» для просмотра полного отчёта без оплаты
NEXT_PUBLIC_DEV_UNLOCK=1
