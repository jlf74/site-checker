# Скопируйте в .env.local и заполните

# Ключ Claude API (console.anthropic.com). Без ключа приложение работает в демо-режиме.
ANTHROPIC_API_KEY=

# Модель для проверок (по умолчанию claude-sonnet-5)
CLAUDE_MODEL=claude-opus-5

# Глубина размышлений модели: low | medium | high | xhigh | max.
# Основная статья расхода: при high проверка стоит ~12 ₽ на Opus, при low ~5 ₽.
# По умолчанию low — задача на извлечение по схеме, глубокое рассуждение не нужно.
CHECK_EFFORT=low

# Секрет для подписи cookie и токенов лимитов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Без него ключ случайный, и лимиты сбрасываются при каждом перезапуске.
CHECKUP_SECRET=

# 1 = показать ссылку «режим разработчика» для просмотра полного отчёта без оплаты.
# НА ПРОДЕ ДОЛЖНО БЫТЬ 0 ИЛИ НЕ ЗАДАНО: иначе любой посетитель откроет платный отчёт даром.
# Переменные с префиксом NEXT_PUBLIC_ вшиваются в код при сборке, а не читаются при запуске —
# поменять её после деплоя недостаточно, нужна пересборка.
NEXT_PUBLIC_DEV_UNLOCK=0
